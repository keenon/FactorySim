{
  "name": "fsim-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "esbuild src/main.tsx --bundle --format=esm --target=es2022 --sourcemap --minify --outfile=dist/app.js",
    "watch": "esbuild src/main.tsx --bundle --format=esm --target=es2022 --sourcemap --outfile=dist/app.js --watch",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --outdir=.test-build --out-extension:.js=.mjs && node --test .test-build/*.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/three": "0.182.0",
    "@types/node": "25.6.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
